{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.elementsmiltonhomes.com" }],
      "destination": "https://elementsmiltonhomes.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/amp", "destination": "/amp.html" },
    { "source": "/amp/", "destination": "/amp.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=UTF-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
