{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.elementsmiltonhomes.com" }],
      "destination": "https://elementsmiltonhomes.com/",
      "permanent": true
    },
    {
      "source": "/:page(amp|amp.html|privacy.html|terms.html|thank-you.html|index.html|llms.txt|site.webmanifest)",
      "has": [{ "type": "host", "value": "www.elementsmiltonhomes.com" }],
      "destination": "https://elementsmiltonhomes.com/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/amp", "destination": "/amp.html" },
    { "source": "/amp/", "destination": "/amp.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "<https://elementsmiltonhomes.com/amp.html>; rel=\"amphtml\"" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemap/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sitemap.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=UTF-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=UTF-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
